#ifndef FOXY_BLOOM_GAUSSIAN_GLSL
#define FOXY_BLOOM_GAUSSIAN_GLSL

vec3 BloomGaussianSource(const in sampler2D sourceTexture, const in vec2 uv) {
	return max(texture2D(sourceTexture, SrPresentationUv(uv)).rgb, vec3(0.0));
}

vec3 BloomGaussian65(const in sampler2D sourceTexture, const in vec2 uv, const in vec2 axis) {
	vec3 bloom = BloomGaussianSource(sourceTexture, uv) * 0.0443403424;
	#define BLOOM_GAUSSIAN_PAIR(offset, weight) \
		bloom += (BloomGaussianSource(sourceTexture, uv + axis * offset) + BloomGaussianSource(sourceTexture, uv - axis * offset)) * weight
	BLOOM_GAUSSIAN_PAIR( 1.49537050, 0.0873264045);
	BLOOM_GAUSSIAN_PAIR( 3.48919921, 0.0821145301);
	BLOOM_GAUSSIAN_PAIR( 5.48303121, 0.0735045062);
	BLOOM_GAUSSIAN_PAIR( 7.47686838, 0.0626364869);
	BLOOM_GAUSSIAN_PAIR( 9.47071258, 0.0508112907);
	BLOOM_GAUSSIAN_PAIR(11.46456567, 0.0392384990);
	BLOOM_GAUSSIAN_PAIR(13.45842952, 0.0288458781);
	BLOOM_GAUSSIAN_PAIR(15.45230594, 0.0201871139);
	BLOOM_GAUSSIAN_PAIR(17.44619677, 0.0134488036);
	BLOOM_GAUSSIAN_PAIR(19.44010381, 0.0085292699);
	BLOOM_GAUSSIAN_PAIR(21.43402885, 0.0051494241);
	BLOOM_GAUSSIAN_PAIR(23.42797364, 0.0029595376);
	BLOOM_GAUSSIAN_PAIR(25.42193993, 0.0016192251);
